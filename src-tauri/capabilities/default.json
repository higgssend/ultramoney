{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "open",
          "cmd": "open",
          "args": [
            "http://*",
            "https://*"
          ]
        }
      ]
    },
    "deep-link:default"
  ]
}